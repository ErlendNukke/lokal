# Required for real Cursor runs (create at https://cursor.com/dashboard/api)
CURSOR_API_KEY=

# cloud = Cursor Cloud Agents API (default)
# local = @cursor/sdk against a folder on this machine
# dry-run = accept orders, never call Cursor (safe for testing the extension)
BRIDGE_MODE=dry-run

# Cloud defaults (used when an order omits repo:)
DEFAULT_REPO_URL=https://github.com/ErlendNukke/lokal
DEFAULT_REF=main
AUTO_CREATE_PR=true
CURSOR_MODEL=composer-2.5

# Local mode only
LOCAL_CWD=

# Bridge server
PORT=3847
HOST=127.0.0.1

# Shared secret the Chrome extension must send (set the same value in extension options)
BRIDGE_TOKEN=change-me

# Deduplicate identical orders for this many minutes
DEDUP_MINUTES=120
